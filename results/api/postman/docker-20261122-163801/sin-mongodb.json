                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Código HTTP 202', () => pm.response.to.have.status(202));",
                    "const j = pm.response.json(); pm.environment.set('job_horario', j.job_id);",
                    "pm.test('Estado inicial queued', () => pm.expect(j.estado).to.eql('queued'));",
                    "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                    "pm.test('Latencia menor a 100 ms', () => pm.expect(pm.response.responseTime).to.be.below(100));"
                  ]
                }
