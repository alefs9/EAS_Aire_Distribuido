          {
            "id": "8c08ce2c-0297-41df-8e78-3f9ebefca104",
            "name": "Esperar resultado final horario",
            "request": {
              "description": {
                "content": "Repite la consulta cada segundo mientras responda 409 (máximo 60 intentos).",
                "type": "text/plain"
              },
              "url": {
                "path": [
                  "jobs",
                  "{{job_horario}}",
                  "results"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "9452824c-7c9e-4531-9d4d-8f4878a0ab78",
                  "type": "text/javascript",
                  "exec": [
                    "const n = Number(pm.environment.get('reintentos') || 0);",
                    "if (pm.response.code === 409 && n < 60) {",
                    "  pm.environment.set('reintentos', n + 1);",
                    "  setTimeout(() => {}, 1000);",
                    "  pm.execution.setNextRequest(pm.info.requestName);",
                    "  return;",
                    "}",
                    "pm.environment.set('reintentos', 0);",
                    "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
                    "const r = pm.response.json().resultado;",
                    "pm.test('Centroides y conteos por clúster', () => { pm.expect(r.centroides.length).to.eql(r.conteos.length); });",
                    "pm.test('Fuente informada', () => pm.expect(['Redis','MongoDB','memoria']).to.include(pm.response.json().fuente));",
                    "pm.test('Latencia menor a 100 ms', () => pm.expect(pm.response.responseTime).to.be.below(100));"
                  ]
                }
              }
            ]
          },
